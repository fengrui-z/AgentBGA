{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbga.dev/schemas/results-v1.schema.json",
  "title": "AgentBGA Results v1",
  "$defs": {
    "latencyStats": {
      "type": "object",
      "required": ["count", "total", "average", "p95", "max"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "total": {"type": "number", "minimum": 0},
        "average": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "tokenUsage": {
      "type": "object",
      "required": ["available", "usage_records", "sources"],
      "properties": {
        "available": {"type": "boolean"},
        "usage_records": {"type": "integer", "minimum": 0},
        "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "cache_write_input_tokens": {"type": "integer", "minimum": 0},
        "uncached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cache_hit_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "harnessMetrics": {
      "type": "object",
      "required": ["schema_version", "players", "totals"],
      "properties": {
        "schema_version": {"const": "agentbga.harness-metrics.v1"},
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "seat", "backend", "model", "controller_calls", "errors", "fallbacks",
              "session_resumes", "compactions", "token_usage", "latency_ms"
            ],
            "properties": {
              "seat": {"type": "integer", "minimum": 0},
              "backend": {"type": "string", "minLength": 1},
              "model": {"type": ["string", "null"]},
              "controller_calls": {"type": "integer", "minimum": 0},
              "errors": {"type": "integer", "minimum": 0},
              "fallbacks": {"type": "integer", "minimum": 0},
              "session_resumes": {"type": "integer", "minimum": 0},
              "compactions": {"type": "integer", "minimum": 0},
              "token_usage": {"$ref": "#/$defs/tokenUsage"},
              "latency_ms": {
                "type": "object",
                "required": ["process", "action"],
                "properties": {
                  "process": {"$ref": "#/$defs/latencyStats"},
                  "action": {"$ref": "#/$defs/latencyStats"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "totals": {
          "type": "object",
          "required": [
            "players", "players_reporting_tokens", "complete", "usage_records",
            "input_tokens", "cached_input_tokens", "cache_write_input_tokens",
            "uncached_input_tokens", "output_tokens", "reasoning_output_tokens",
            "total_tokens", "cache_hit_rate"
          ],
          "properties": {
            "players": {"type": "integer", "minimum": 0},
            "players_reporting_tokens": {"type": "integer", "minimum": 0},
            "complete": {"type": "boolean"},
            "usage_records": {"type": "integer", "minimum": 0},
            "input_tokens": {"type": "integer", "minimum": 0},
            "cached_input_tokens": {"type": "integer", "minimum": 0},
            "cache_write_input_tokens": {"type": "integer", "minimum": 0},
            "uncached_input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "reasoning_output_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0},
            "cache_hit_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version", "experiment_id", "run_id", "mode", "generated_at",
    "complete", "summary", "matches", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "agentbga.results.v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mode": {"enum": ["duel", "tournament", "series"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "complete": {"type": "boolean"},
    "summary": {
      "type": "object",
      "required": ["scheduled_matches", "reported_matches", "completed_matches", "failed_matches"],
      "properties": {
        "scheduled_matches": {"type": "integer", "minimum": 1},
        "reported_matches": {"type": "integer", "minimum": 0},
        "completed_matches": {"type": "integer", "minimum": 0},
        "failed_matches": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["result_id", "ordinal", "status", "game", "seed", "player_count", "participants"],
        "properties": {
          "result_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "ordinal": {"type": "integer", "minimum": 1},
          "status": {"enum": ["ok", "error"]},
          "game": {"type": "string", "minLength": 1},
          "rules_version": {"type": "string", "minLength": 1},
          "seed": {"type": "integer"},
          "player_count": {"type": "integer", "minimum": 2, "maximum": 4},
          "participants": {"type": "array", "minItems": 2, "maxItems": 4},
          "series_id": {"type": ["string", "null"]},
          "series_replicate": {"type": ["integer", "null"]},
          "series_game_index": {"type": ["integer", "null"]},
          "base_seed": {"type": ["integer", "null"]},
          "result": {
            "type": "object",
            "properties": {
              "harness_metrics": {"$ref": "#/$defs/harnessMetrics"}
            },
            "additionalProperties": true
          },
          "error": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "submission": {
      "type": "object",
      "required": ["token"],
      "properties": {"token": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "content_digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
