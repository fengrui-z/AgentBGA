# Copy the variable names into the server's secret manager or interactive shell.
# Do not commit populated values.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# Kimi K2.7 Code currently uses a workspace-specific Model Studio endpoint.
# Replace <WorkspaceId> and export the complete URL.
DASHSCOPE_KIMI_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
